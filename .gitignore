# Whitelist: only the backend, the frontend, the submission documents and the root files below are tracked.
# Everything else in this directory (research notes, drafts, registration forms, videos) stays local.
/*
!/.gitignore
!/.github/
!/README.md
!/clauseguard/
!/clauseguard-web/
!/documentation-submission/

# Document sources and tools that are not part of the code
/clauseguard/docs/
/clauseguard/scripts/build_docs.py
/clauseguard/scripts/make_submission_zip.py
/clauseguard/scripts/translate_docs.py
/clauseguard/scripts/translate_fix.py

# Defensive, in case a nested ignore file is ever removed
.env
.env.*
!.env.example
node_modules/
.next/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.sqlite
*.sqlite-*

# local audit fallback chain written while Postgres is unreachable
*.pgfallback
*.pgfallback.lock
