# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=your_key_here
# Optional pool, comma separated; wrapper rotates on 429
GEMINI_API_KEYS=
# Models
CG_MODEL_EXTRACT=gemini-3.6-flash         # policy extraction, once per document, cached
CG_MODEL_FAST=gemini-3.5-flash-lite       # every query-time step
CG_MODEL_CLAIM_DOC=gemini-3.5-flash-lite  # invoices and discharge summaries; falls back to CG_MODEL_EXTRACT
CG_MODEL_EMBED=gemini-embedding-001
# Optional free fallbacks for the explainer only (never for decisions)
GROQ_API_KEY=
# Sandbox
CG_DB_PATH=data/sandbox.sqlite
CG_AUDIT_PATH=evidence/audit_log.jsonl
CG_KILL_SWITCH_PATH=evidence/AGENT_HALT
CG_CLAIM_AMOUNT_CAP_IDR=100000000
# Back-office/admin credential (gates /admin/kill and /backoffice/*). Required before any
# admin/back-office demo; if unset, those endpoints are disabled (403) and the rest of the app
# still works. Set a real random value, never commit it.
CG_ADMIN_TOKEN=
# Accounts (optional). CG_AUTH=supabase requires every user to sign in with a confirmed Supabase email account;
# without it the open sandbox login is used (local clone, tests). Needs SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY.
# CG_AUTH=supabase
# CG_DEMO_ACCOUNTS=rizky@demo.clauseguard.id=rizky,santoso@demo.clauseguard.id=santoso,dewi@demo.clauseguard.id=dewi
# Persistence. Default is local files/SQLite. Set both to keep audit log, history, claims and tickets in Postgres.
CG_STORAGE=local
DATABASE_URL=

# Hosted deployment (set as platform secrets, never baked into the image)
# CG_ENV=production
# CG_STORAGE=postgres
# DATABASE_URL=
