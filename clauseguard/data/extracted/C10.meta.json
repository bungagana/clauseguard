  {
   "term": "Index Account",
   "canonical_event": null,
   "definition": "An account where interest credits are based on the performance of a stock market index."
  },
  {
   "term": "Fixed Account",
   "canonical_event": null,
   "definition": "An account earning a guaranteed fixed interest rate."
  },
  {
   "term": "Cap Rate",
   "canonical_event": null,
   "definition": "The maximum interest rate that can be credited to an index account in any crediting period."
  },
  {
   "term": "Floor Rate",
   "canonical_event": null,
   "definition": "The minimum interest rate (0%) that will be credited, protecting against market losses."
  },
  {
   "term": "Participation Rate",
   "canonical_event": null,
   "definition": "The percentage of index gain that is credited to your account."
  },
  {
   "term": "Point-to-Point Method",
   "canonical_event": null,
   "definition": "Interest crediting based on index change from beginning to end of crediting period (annual)."
  }
