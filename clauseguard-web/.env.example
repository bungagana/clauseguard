NEXT_PUBLIC_API_URL=http://localhost:8000

# Production (Vercel): backend base URL used by the /api/cg rewrite; takes precedence over NEXT_PUBLIC_API_URL
# BACKEND_URL=https://<user>-<space>.hf.space

# "demo" shows the persona picker, demo badge and demo scenes (what judges see);
# "production" hides them and starts from an upload-your-own-policy empty state.
NEXT_PUBLIC_APP_MODE=demo

# Accounts: set both to put a sign-in page in front of the chat (inlined at build time).
# The key is the project's publishable (anon) key, which is safe to expose; never use a service-role key here.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
